# ------------------------------------------------------------------
# Srija — environment configuration
# Copy this file to ".env" and fill in the values.
# Everything prefixed VITE_ is safe to ship to the browser.
# NEVER put private keys / service accounts / OAuth secrets here.
# ------------------------------------------------------------------

# Google Apps Script Web App URL that saves enquiries to Google Sheets.
# See README.md → "Google Sheets setup" for the 5-minute guide.
VITE_SHEETS_WEBAPP_URL=

# Optional overrides for media (you can also edit src/config/site.ts directly).
# Accepts a direct URL or any public Google Drive link/file-id.
VITE_HERO_VIDEO_URL=
VITE_HERO_POSTER_URL=
VITE_PROFILE_IMAGE_URL=

# Canonical site URL, used for SEO tags (e.g. https://srija.com)
VITE_SITE_URL=
